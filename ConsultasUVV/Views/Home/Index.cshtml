@{
    ViewData["Title"] = "Início";
}

<section class="hero">
    <h1>Gestão de Consultas</h1>
    <p>
        Registre e organize suas consultas médicas ou profissionais.
        Simples, rápido e seguro.
    </p>
    <div class="actions actions--center">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-controller="Consultas" asp-action="Index">Ver minhas consultas</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Conta" asp-action="Registrar">Criar conta</a>
            <a class="btn btn-plain" asp-controller="Conta" asp-action="Login">Entrar</a>
        }
    </div>
</section>
